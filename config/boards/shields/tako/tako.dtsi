#include <dt-bindings/zmk/matrix_transform.h>
// #include <dt-bindings/zmk/kscan.h>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>
#include <zephyr/dt-bindings/gpio/gpio.h>

// #include "tako-layouts.dtsi"

/ {
    chosen {
        /*
         * 保留左右 overlay 里的 zmk,kscan = &kscan;
         * 这里改为 Studio 使用的 physical layout。
         */
        zmk,physical-layout = &cuddlykeyboards_ferris_layout;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,9) RC(0,8) RC(0,7) RC(0,6) RC(0,5)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,9) RC(1,8) RC(1,7) RC(1,6) RC(1,5)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,9) RC(2,8) RC(2,7) RC(2,6) RC(2,5)
            RC(3,1) RC(3,0) RC(3,5) RC(3,6)
        >;
    };
};

/*
 * Ferris physical layout 自带 34 个按键的 keys 坐标定义，
 * 这里只把你的 Tako matrix transform 绑定进去。
 *
 * kscan 不写在这里，因为左右 overlay 已经通过 chosen
 * 选择了各自的 &kscan。
 */
&cuddlykeyboards_ferris_layout {
    transform = <&default_transform>;
};

&i2c0 {
    status = "disabled";
};

&i2c1 {
    status = "disabled";
};

/*
 * nice!view SPI pins on nice!nano v2:
 *
 * MOSI = P1.01
 * SCK  = P1.02
 * CS   = P1.07
 */

