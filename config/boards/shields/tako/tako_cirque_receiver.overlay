/* Receive the right-side Cirque on either existing central firmware. */
#include "tako-cirque-split.dtsi"
#include <input/processors/scaler.dtsi>

&tako_cirque_listener {
    status = "okay";
    /* 1.5x pointer travel; receiver listeners preserve fractional remainders.
     * Limit scaling to relative X/Y so taps and scroll events stay unchanged. */
    input-processors = <&zip_xy_scaler 3 2>;
};
