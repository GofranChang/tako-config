/* Add after tako_right, without nice_view/nice_view_custom.
 * Reuse its display socket: MOSI -> SDA, SCK -> SCL, CS -> DR.
 */
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>
#include "tako-cirque-split.dtsi"

&tako_cirque_split {
    device = <&tako_cirque>;
};

&spi1 {
    status = "disabled";
};

&pinctrl {
    tako_cirque_i2c_default: tako_cirque_i2c_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 17)>,
                    <NRF_PSEL(TWIM_SCL, 0, 20)>;
        };
    };

    tako_cirque_i2c_sleep: tako_cirque_i2c_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 17)>,
                    <NRF_PSEL(TWIM_SCL, 0, 20)>;
            low-power-enable;
        };
    };
};

&i2c0 {
    compatible = "nordic,nrf-twi";
    status = "okay";
    clock-frequency = <I2C_BITRATE_STANDARD>;
    pinctrl-0 = <&tako_cirque_i2c_default>;
    pinctrl-1 = <&tako_cirque_i2c_sleep>;
    pinctrl-names = "default", "sleep";

    tako_cirque: trackpad@2a {
        compatible = "cirque,pinnacle";
        reg = <0x2a>;
        status = "okay";
        dr-gpios = <&gpio0 9 GPIO_ACTIVE_HIGH>;
        /* Retain Tako's original 1x setting with the Toucan driver, for
         * TM040040-2024-303 with the concave overlay. This is ADC attenuation,
         * not cursor speed. Validate tracking/hover on the assembled keyboard. */
        sensitivity = "1x";
        /* Mounted orientation: reverse horizontal movement only. */
        x-invert;
    };
};
